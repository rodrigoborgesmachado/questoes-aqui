{
  "name": "questoes-aqui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:app": "vite build --mode app",
    "lint": "oxlint",
    "test": "node --test",
    "preview": "vite preview",
    "app:sync": "npm run build:app && cap sync android",
    "app:open": "cap open android",
    "app:release": "npm run app:sync && cd android && .\\gradlew bundleRelease",
    "app:assets": "capacitor-assets generate --android --iconBackgroundColor \"#4f46e5\" --iconBackgroundColorDark \"#4f46e5\" --splashBackgroundColor \"#f5f6fb\" --splashBackgroundColorDark \"#1e1e1e\""
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/core": "^8.6.2",
    "@capacitor/share": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@reduxjs/toolkit": "^2.14.0",
    "axios": "^1.21.0",
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.2",
    "browser-image-compression": "^2.0.2",
    "date-fns": "^4.4.0",
    "file-saver": "^2.0.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-redux": "^9.3.1",
    "react-router-dom": "^7.18.5",
    "react-toastify": "^11.2.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.90.0",
    "vite": "^8.3.6"
  }
}
